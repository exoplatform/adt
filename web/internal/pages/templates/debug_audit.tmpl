
<div class="card">
  <div class="card-header"><i class="fas fa-clipboard-list me-2"></i>Audit log ({{ .Shown }} shown, latest first)</div>
  <div class="card-body">
    <form method="get" class="row g-2 mb-3">
      <div class="col-md-3">
        <select name="action" class="form-select form-select-sm" aria-label="Action">
          <option value="">All actions</option>
{{ range .Actions }}          <option value="{{ esc .Value }}"{{ if .Selected }} selected{{ end }}>{{ esc .Value }}</option>
{{ end }}        </select>
      </div>
      <div class="col-md-3">
        <select name="user" class="form-select form-select-sm" aria-label="User">
          <option value="">All users</option>
{{ range .Users }}          <option value="{{ esc .Value }}"{{ if .Selected }} selected{{ end }}>{{ esc .Value }}</option>
{{ end }}        </select>
      </div>
      <div class="col-md-4"><input type="search" name="q" value="{{ esc .Q }}" class="form-control form-control-sm" placeholder="Search" aria-label="Search"></div>
      <div class="col-md-2"><button class="btn btn-sm btn-primary" type="submit">Filter</button> <a class="btn btn-sm btn-outline-secondary" href="/debug-audit">Reset</a></div>
    </form>
    <div class="table-responsive">
    <table class="table table-hover table-themed table-sm align-middle">
      <thead><tr><th>Time (UTC)</th><th>User</th><th>IP</th><th>Action</th><th>Detail</th></tr></thead>
      <tbody>
{{ range .Entries }}        <tr>
          <td class="text-nowrap">{{ .Time }}</td>
          <td>{{ esc .User }}</td>
          <td>{{ esc .IP }}</td>
          <td><code>{{ esc .Action }}</code></td>
          <td class="small">{{ esc .Detail }}</td>
        </tr>
{{ else }}        <tr><td colspan="5" class="text-muted">No entry.</td></tr>
{{ end }}      </tbody>
    </table>
    </div>
  </div>
</div>
