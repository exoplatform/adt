    ServerAdmin exo-swf@exoplatform.com

    ErrorLog        {{ ADT_DATA }}/var/log/apache2/{{ DEPLOYMENT_EXT_HOST }}-error.log
    LogLevel        warn
    CustomLog       {{ ADT_DATA }}/var/log/apache2/{{ DEPLOYMENT_EXT_HOST }}-access.log combined

    # don't loose time with IP address lookups
    HostnameLookups Off

    # needed for named virtual hosts
    UseCanonicalName Off

    # configures the footer on server-generated documents
    ServerSignature Off

    # Apache terminates the TLS of the client, authenticates it and forwards everything to the nginx of the instance, which owns the
    # locations, the security headers, the compression and the logs. Apache only answers by itself when nginx is down (instance
    # stopped), with the pages below, and for the Certbot challenge.
    ErrorDocument 404 /errors/instance/404.html
    ErrorDocument 500 /errors/instance/500.html
    ErrorDocument 502 /errors/instance/502.html
    ErrorDocument 503 /errors/instance/503.html

    <Directory />
        Options FollowSymLinks
        AllowOverride None
    </Directory>

    # Static files of the dashboard (web/static): here the error pages of /errors/instance/ and what they use
    DocumentRoot {{ ADT_DATA }}/web/static/
    <Directory {{ ADT_DATA }}/web/static/>
        Options FollowSymLinks
        AllowOverride None
        Require all granted
    </Directory>

    # Serve Certbot challenge files directly
    Alias /.well-known/acme-challenge/ {{ DEPLOYMENT_CERTBOT_WEBROOT_PATH }}/.well-known/acme-challenge/
    <Directory "{{ DEPLOYMENT_CERTBOT_WEBROOT_PATH }}/.well-known/acme-challenge/">
        AllowOverride None
        Options None
        Require all granted
    </Directory>

{% set nginx_tls = DEPLOYMENT_NGINX_TLS == "true" -%}
{% set upstream = "127.0.0.1:" ~ DEPLOYMENT_HTTP_PORT -%}
    ProxyRequests           Off
    ProxyPreserveHost       On
    ProxyTimeout            300
    ProxyPass               /errors/instance/    !
    ProxyPass               /style.css           !
    ProxyPass               /images/favicon.ico  !
    ProxyPass               /images/favicon-16x16.png !
    ProxyPass               /images/favicon-32x32.png !
    ProxyPass               /images/favicon-48x48.png !
    ProxyPass               /images/apple-touch-icon.png !
    ProxyPass               /images/logo.svg     !
    ProxyPass               /.well-known/acme-challenge/  !
{% if nginx_tls %}

    # The nginx of the instance serves the same certificate as this virtual host: the hop stays on the loopback of the server
    SSLProxyEngine          on
    SSLProxyVerify          none
    SSLProxyCheckPeerName   off
    SSLProxyCheckPeerCN     off
{% endif %}

{% if DEPLOYMENT_APACHE_WEBSOCKET_ENABLED == "true" %}
    <IfModule mod_proxy_wstunnel.c>
        RewriteEngine on
        RewriteCond %{HTTP:Upgrade} websocket [NC]
        RewriteCond %{HTTP:Connection} upgrade [NC]
        RewriteRule ^/?(.*) "{{ "wss" if nginx_tls else "ws" }}://{{ upstream }}/$1" [P,L]
    </IfModule>

{% endif %}
    ProxyPass               /       {{ "https" if nginx_tls else "http" }}://{{ upstream }}/ retry=0
    ProxyPassReverse        /       {{ "https" if nginx_tls else "http" }}://{{ upstream }}/

    <IfModule http2_module>
        # Conflicting with preload and prefetch headers; H2 Push needs to be disabled; https://httpd.apache.org/docs/2.4/howto/http2.html#server-push
        H2Push Off
    </IfModule>
