    ServerAdmin exo-swf@exoplatform.com

    ErrorLog        {{ ADT_DATA }}/var/log/apache2/{{ DEPLOYMENT_EXT_HOST }}-error.log
    LogLevel        warn
    CustomLog       {{ ADT_DATA }}/var/log/apache2/{{ DEPLOYMENT_EXT_HOST }}-access.log combined

    # Error pages
    ErrorDocument 404 /404.html
    ErrorDocument 500 /500.html
    ErrorDocument 502 /502.html
    ErrorDocument 503 /503.html

    # don't loose time with IP address lookups
    HostnameLookups Off

    # needed for named virtual hosts
    UseCanonicalName Off

    # configures the footer on server-generated documents
    ServerSignature Off

    <IfModule brotli_module>
        #
        # Compression using Brotli
        #
        SetOutputFilter BROTLI_COMPRESS
        BrotliCompressionQuality 5
        BrotliFilterNote Input instream
        BrotliFilterNote Output outstream
        BrotliFilterNote Ratio ratio

        # Don't compress images
        SetEnvIfNoCase Request_URI "\.(?:gif|jpe?g|png|webp)$" no-brotli dont-vary
        # Make sure proxies don't deliver the wrong content
        Header append Vary User-Agent env=!dont-vary
    </IfModule>
    <IfModule !brotli_module>
        <IfModule deflate_module>
            #
            # Compression using Gzip (fallback)
            #
            SetOutputFilter DEFLATE
            DeflateCompressionLevel 5
            DeflateFilterNote Input instream
            DeflateFilterNote Output outstream
            DeflateFilterNote Ratio ratio

            # Don't compress images
            SetEnvIfNoCase Request_URI "\.(?:gif|jpe?g|png|webp)$" no-gzip dont-vary
            # Make sure proxies don't deliver the wrong content
            Header append Vary User-Agent env=!dont-vary
        </IfModule>
    </IfModule>

    <Directory />
        Options FollowSymLinks
        AllowOverride None
    </Directory>

    DocumentRoot {{ ADT_DATA }}/var/www/
    <Directory {{ ADT_DATA }}/var/www/>
        Options Indexes FollowSymLinks MultiViews
        AllowOverride None
        Require all granted
    </Directory>

    Alias /icons/ "/usr/share/apache2/icons/"
    <Directory "/usr/share/apache2/icons">
        Options Indexes MultiViews
        AllowOverride None
        Require all granted
    </Directory>

    Alias /logs/ "{{ DEPLOYMENT_DIR }}/logs/"
    <Directory "{{ DEPLOYMENT_DIR }}/logs/">
        Options Indexes MultiViews
        AllowOverride None
        Require all granted
    </Directory>

{% if DEPLOYMENT_MATRIX_ENABLED == "true" %}
    Alias /.well-known/matrix/ "{{ DEPLOYMENT_DIR }}/matrix/"
    <Directory "{{ DEPLOYMENT_DIR }}/matrix/">
        Options Indexes MultiViews
        AllowOverride None
        Require all granted
    </Directory>

{% endif %}
    # Serve Certbot challenge files directly
    Alias /.well-known/acme-challenge/ {{ DEPLOYMENT_CERTBOT_WEBROOT_PATH }}/.well-known/acme-challenge/
    <Directory "{{ DEPLOYMENT_CERTBOT_WEBROOT_PATH }}/.well-known/acme-challenge/">
        AllowOverride None
        Options None
        Require all granted
    </Directory>

{% if PRODUCT_NAME == "meeds" %}
    <Location "/deeds-dapp/api/hubs/">
        Header always set Access-Control-Allow-Origin "*"
        Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Header always set Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range"
        Header always set Access-Control-Expose-Headers "Content-Length,Content-Range"
    </Location>
{% endif %}

    RewriteEngine on 
{% if DEPLOYMENT_CALDAV_ENABLED == "true" %}
    RewriteRule ^/\.well-known/caldav$ /baikal/dav.php [R]
    RewriteRule ^/\.well-known/carddav$ /baikal/dav.php [R]
{% endif %}
{% if DEPLOYMENT_MAILPIT_ENABLED == "true" %}
    RewriteRule ^/mailpit$ /mailpit/ [R]
{% endif %}
{% if DEPLOYMENT_FRONTAIL_ENABLED == "true" %}
    RewriteRule ^/livelogs$ /livelogs/ [R]
{% endif %}
{% if DEPLOYMENT_CLOUDBEAVER_ENABLED == "true" %}
    RewriteRule ^/cloudbeaver$ /cloudbeaver/ [R]
{% endif %}
{% if DEPLOYMENT_CALDAV_ENABLED == "true" %}
    RewriteRule ^/baikal$ /baikal/ [R]
{% endif %}
    RewriteRule ^/logs$ /logs/ [R]
{% if DEPLOYMENT_CALDAV_ENABLED == "true" %}
    RewriteRule ^/baikal/admin$ /baikal/admin/ [R]
{% endif %}
{% if DEPLOYMENT_MATRIX_ENABLED == "true" %}
    RewriteRule ^/_matrix/push/v1/notify$ /matrix/rest/matrix/notify [PT]
{% endif %}

    ProxyRequests           Off
    ProxyPreserveHost       On
    ProxyPass               /404.html            !
    ProxyPass               /500.html            !
    ProxyPass               /502.html            !
    ProxyPass               /503.html            !
    ProxyPass               /robots.txt          !
    ProxyPass               /style.css           !
    ProxyPass               /logs/               !
{% if DEPLOYMENT_MATRIX_ENABLED == "true" %}
    ProxyPass               /.well-known/matrix/ !
{% endif %}
    ProxyPass               /.well-known/acme-challenge/  !
    ProxyPass               /icons/              !
    ProxyPass               /images/favicon.ico  !

{% if DEPLOYMENT_APACHE_WEBSOCKET_ENABLED == "true" or DEPLOYMENT_JITSI_ENABLED == "true" %}
    <IfModule mod_proxy_wstunnel.c>
{% if DEPLOYMENT_APACHE_WEBSOCKET_ENABLED == "true" %}
{% if DEPLOYMENT_ONLYOFFICE_DOCUMENTSERVER_ENABLED == "true" %}
        # Proxify of websocket url pattern for onlyoffice
   
        RewriteCond %{REQUEST_URI} !^/(cometd|chatServer|jitsiweb|xmpp-websocket|colibri-ws|whiteboard|livelogs|socket.io|mailpit|cloudbeaver)/
        RewriteCond %{HTTP:Upgrade} websocket [NC]
        RewriteCond %{HTTP:Connection} upgrade [NC]
        RewriteRule ^/?(.*) "ws://localhost:{{ DEPLOYMENT_ONLYOFFICE_HTTP_PORT }}/$1$2" [P,L]

{% endif %}
        ProxyPass /cometd ws://localhost:{{ DEPLOYMENT_HTTP_PORT }}/cometd max=200 acquire=5000 retry=5
{% if DEPLOYMENT_CHAT_EMBEDDED != "true" %}
        ProxyPass /chatServer/cometd ws://localhost:{{ DEPLOYMENT_CHAT_SERVER_PORT }}/chatServer/cometd max=200 acquire=5000 retry=5
{% endif %}

{% if DEPLOYMENT_CLOUDBEAVER_ENABLED == "true" %}
        <Location "/cloudbeaver/api/ws">
            ProxyPass "ws://localhost:{{ DEPLOYMENT_CLOUDBEAVER_HTTP_PORT }}/cloudbeaver/api/ws"
            ProxyPassReverse "ws://localhost:{{ DEPLOYMENT_CLOUDBEAVER_HTTP_PORT }}/cloudbeaver/api/ws"
            RequestHeader set Upgrade "websocket"
            RequestHeader set Connection "upgrade"
        </Location>
{% endif %}

{% if DEPLOYMENT_MAILPIT_ENABLED == "true" %}
        <Location "/mailpit/api/events">
            ProxyPass "ws://localhost:{{ DEPLOYMENT_MAILPIT_HTTP_PORT }}/mailpit/api/events"
            ProxyPassReverse "ws://localhost:{{ DEPLOYMENT_MAILPIT_HTTP_PORT }}/mailpit/api/events"
            RequestHeader set Upgrade "websocket"
            RequestHeader set Connection "upgrade"
        </Location>
{% endif %}

{% if DEPLOYMENT_FRONTAIL_ENABLED == "true" %}
        <Location "/livelogs/socket.io/">
            ProxyPass "ws://localhost:{{ DEPLOYMENT_FRONTAIL_HTTP_PORT }}/livelogs/socket.io/"
            ProxyPassReverse "ws://localhost:{{ DEPLOYMENT_FRONTAIL_HTTP_PORT }}/livelogs/socket.io/"
        </Location>
{% endif %}

{% if DEPLOYMENT_MATRIX_ENABLED == "true" %}
        <Location "/_matrix/push/v1/notify">
            Header set Access-Control-Allow-Headers "Authorization"
            ProxyPass "http://localhost:{{ DEPLOYMENT_HTTP_PORT }}/matrix/rest/matrix/notify"
            ProxyPassReverse "http://localhost:{{ DEPLOYMENT_HTTP_PORT }}/matrix/rest/matrix/notify"
        </Location>
{% endif %}
{% endif %}

{% if DEPLOYMENT_JITSI_ENABLED == "true" %}
        # Jitsi websockets (kept even when DEPLOYMENT_APACHE_WEBSOCKET_ENABLED is false)
        <Location "/jitsiweb/xmpp-websocket">
            ProxyPass "ws://localhost:{{ DEPLOYMENT_JITSI_WEB_HTTP_PORT }}/xmpp-websocket"
        </Location>
        <Location "/jitsiweb/colibri-ws/">
            ProxyPass "ws://localhost:{{ DEPLOYMENT_JITSI_JVB_COLIBRI_PORT }}/colibri-ws/"
        </Location>
        <Location "/whiteboard/">
            ProxyPass "ws://localhost:{{ DEPLOYMENT_JITSI_EXCALIDRAW_BACKEND_PORT }}/"
        </Location>
        <Location "/socket.io/">
            ProxyPass "ws://localhost:{{ DEPLOYMENT_JITSI_EXCALIDRAW_BACKEND_PORT }}/socket.io/"
        </Location>
{% endif %}
    </IfModule>
{% endif %}

    <IfModule http2_module>
        # Conflicting with preload and prefetch headers; H2 Push needs to be disabled; https://httpd.apache.org/docs/2.4/howto/http2.html#server-push
        H2Push Off
    </IfModule>

{% if DEPLOYMENT_CMISSERVER_ENABLED == "true" %}
    ProxyPass               /cmis       http://localhost:{{ DEPLOYMENT_CMIS_HTTP_PORT }}/cmis acquire=1000 retry=30
    ProxyPassReverse        /cmis       http://localhost:{{ DEPLOYMENT_CMIS_HTTP_PORT }}/cmis
{% endif %}

{% if DEPLOYMENT_CALDAV_ENABLED == "true" %}
