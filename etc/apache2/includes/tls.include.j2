    # TLS settings shared by the HTTPS virtual hosts (the certificate files stay in each vhost)
    SSLVerifyClient None

    SSLCipherSuite          ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384
    SSLProtocol             +TLSv1.2 +TLSv1.3
    SSLHonorCipherOrder     on
    SSLCompression          off
    SSLSessionTickets       off
