    ServerAdmin exo-swf@exoplatform.com

    # The dashboard is adt-web (Go), reached through a unix socket (see "adt-web hand-off" at the end of this
    # file). Apache keeps the authentication, the TLS and the access logs.

    # Error pages. 403 is a dynamic page of adt-web (a revoked session goes back to the login page). The 404/500/
    # 502/503 pages are static files served by Apache itself (end of this file), so they still show when adt-web is down.
    ErrorDocument 403 /errors/frontend/403.html
    ErrorDocument 404 /errors/frontend/404.html
    ErrorDocument 500 /errors/frontend/500.html
    ErrorDocument 502 /errors/frontend/502.html
    ErrorDocument 503 /errors/frontend/503.html

    Include {{ APACHE_CONF_DIR }}/includes/security-headers.include

    ErrorLog        {{ ADT_DATA }}/var/log/apache2/{{ ACCEPTANCE_HOST }}-error.log
    LogLevel        warn
    CustomLog       {{ ADT_DATA }}/var/log/apache2/{{ ACCEPTANCE_HOST }}-access.log combined

    Include {{ APACHE_CONF_DIR }}/includes/compression.include

    # Cache headers (a week for images, two hours for CSS/JS, none for the service worker and the dynamic pages)
    # are set by adt-web itself: Apache only proxies those responses, so FilesMatch rules would never apply.

    # don't loose time with IP address lookups
    HostnameLookups Off

    # needed for named virtual hosts
    UseCanonicalName Off

    # configures the footer on server-generated documents
    ServerSignature Off

    <Directory />
        Options FollowSymLinks
        AllowOverride None
    </Directory>

    # Only the static error pages (404/500/502/503) are read from disk by Apache; everything else is proxied.
    DocumentRoot {{ ADT_DATA }}/web/static/
    <Directory {{ ADT_DATA }}/web/static/>
        Options None
        AllowOverride None
        Require all granted
    </Directory>

    Alias /icons/ "/usr/share/apache2/icons/"
    <Directory "/usr/share/apache2/icons">
        Options Indexes MultiViews
        AllowOverride None
        Require all granted
    </Directory>

    Alias /downloads/ "{{ ADT_DATA }}/downloads/"
    <Directory "{{ ADT_DATA }}/downloads/">
        Options Indexes MultiViews
        AllowOverride None
        Require all granted
    </Directory>

    Alias /datasets/ "{{ ADT_DATA }}/datasets/"
    <Directory "{{ ADT_DATA }}/datasets/">
        Options Indexes MultiViews
        AllowOverride None
        Require all granted
    </Directory>

    Alias /logs/ "{{ ADT_DATA }}/var/log/apache2/"
    <Directory "{{ ADT_DATA }}/var/log/apache2/">
        Options Indexes MultiViews
        AllowOverride None
        Require all granted
    </Directory>

    #Awstats
    Alias /awstatsclasses "/usr/share/awstats/lib/"
    Alias /awstats-icon/ "/usr/share/awstats/icon/"
    Alias /awstatscss "/usr/share/doc/awstats/examples/css"
    ScriptAlias /stats/ /usr/lib/cgi-bin/
    RedirectMatch "^stats/?$" "/stats/awstats.pl"
    <Directory /usr/lib/cgi-bin>
        Options -Indexes +ExecCGI -MultiViews +SymLinksIfOwnerMatch
    </Directory>

    # Security
    # The dashboard UI uses a login page (mod_auth_form + LDAP backend) backed by an
    # encrypted session cookie. Every path not explicitly opened below stays protected.
    # Requires: a2enmod auth_form session session_cookie session_crypto request authnz_ldap
    Session                 On
    SessionCookieName       adt_session path=/;httponly;secure;samesite=lax
    SessionCryptoPassphrase {{ ADT_SESSION_PASSPHRASE }}
    SessionMaxAge           28800
    # Fixed lifetime: do not let later requests re-stamp the expiry with this default
    # (it would cut a 7-day "remember me" session down to 8h)
    SessionExpiryUpdateInterval 604800

    <Location />
            # Expose the decrypted session (incl. its expiry) as HTTP_SESSION for the dashboard
            SessionEnv On
            AuthName "eXo Employees only"
            AuthType form
            AuthFormProvider ldap
            # Remember the requested URL so the login page can send the user back to it
            AuthFormLoginRequiredLocation "/login?next=%{escape:%{REQUEST_URI}?%{QUERY_STRING}}"
            # Authenticated but not in the group: 403 page instead of a bare 401
            AuthzSendForbiddenOnFailure On

            AuthLDAPBindDN          "{{ LDAP_ACCEPTANCE_BIND_DN }}"
            AuthLDAPBindPassword    {{ LDAP_ACCEPTANCE_BIND_PASSWORD }}
            AuthLDAPURL ldaps://ldap2.exoplatform.org/ou=users,ou=portal,dc=exoplatform,dc=org?cn,mail,displayName
            <RequireAll>
                Require    ldap-group cn=exo-employees,ou=groups,dc=exoplatform,dc=org
                # Sessions evicted from /debug-sessions (sha1 of the session cookie, listed in revoked.txt
                # by the dashboard); the 403 error page then sends the user back to the login page.
                # Uses the raw cookie: the decrypted HTTP_SESSION is only set after authorization.
                Require    expr "!(%{req:Cookie} =~ /(?:^|; ?)adt_session=([^;]+)/ && file('{{ ADT_DATA }}/var/sessions/revoked.txt') -strmatch '*' . sha1($1) . '*')"
                # Users blocked from /debug-sessions (sha1 of the lowercased login, same file). RequireNone, not a negated
                # expr: a false expr using REMOTE_USER ends as a bare 401 instead of the 403 page
                <RequireNone>
                    Require expr "file('{{ ADT_DATA }}/var/sessions/revoked.txt') -strmatch '*' . sha1(tolower(%{REMOTE_USER})) . '*'"
                </RequireNone>
                AuthLDAPMaxSubGroupDepth 1
            </RequireAll>
    </Location>

    # Debug pages (/debug and /debug-*): members of the LDAP group LDAP_ACCEPTANCE_APACHE2_ADMIN_DN only.
    # AuthMerging is Off by default, so this Require replaces the exo-employees one above
    # mod_authnz_ldap does not inherit AuthLDAPURL from <Location />: repeat the auth settings.
    <LocationMatch "^/debug[^/]*$">
            SessionEnv On
            AuthName "eXo Employees only"
            AuthType form
            AuthFormProvider ldap
            AuthFormLoginRequiredLocation "/login?next=%{escape:%{REQUEST_URI}?%{QUERY_STRING}}"
            AuthzSendForbiddenOnFailure On

            AuthLDAPBindDN          "{{ LDAP_ACCEPTANCE_BIND_DN }}"
            AuthLDAPBindPassword    {{ LDAP_ACCEPTANCE_BIND_PASSWORD }}
            AuthLDAPURL ldaps://ldap2.exoplatform.org/ou=users,ou=portal,dc=exoplatform,dc=org?cn,mail,displayName
            <RequireAll>
                Require    ldap-group {{ LDAP_ACCEPTANCE_APACHE2_ADMIN_DN }}
                # Sessions evicted from /debug-sessions (sha1 of the session cookie, listed in revoked.txt
                # by the dashboard); the 403 error page then sends the user back to the login page.
                # Uses the raw cookie: the decrypted HTTP_SESSION is only set after authorization.
                Require    expr "!(%{req:Cookie} =~ /(?:^|; ?)adt_session=([^;]+)/ && file('{{ ADT_DATA }}/var/sessions/revoked.txt') -strmatch '*' . sha1($1) . '*')"
                # Users blocked from /debug-sessions (sha1 of the lowercased login, same file). RequireNone, not a negated
                # expr: a false expr using REMOTE_USER ends as a bare 401 instead of the 403 page
                <RequireNone>
                    Require expr "file('{{ ADT_DATA }}/var/sessions/revoked.txt') -strmatch '*' . sha1(tolower(%{REMOTE_USER})) . '*'"
                </RequireNone>
                AuthLDAPMaxSubGroupDepth 1
            </RequireAll>
    </LocationMatch>

    # Login page (public) and the handlers processing the form
    <LocationMatch "^/(login|403\.html)$|^/errors/frontend/403\.html$">
        Require all granted
    </LocationMatch>
    # Lets adt-web see whether the visitor already has a session (redirected to /)
    <LocationMatch "^/login$">
        SessionEnv On
    </LocationMatch>
    <Location /dologin>
        SetHandler form-login-handler
        AuthFormLoginRequiredLocation "/login"
        AuthFormLoginSuccessLocation  "/"
        Require all granted
    </Location>
    # "Remember me": same handler, but the session (and its cookie) lives 7 days
    <Location /dologin-remember>
        SetHandler form-login-handler
        AuthFormLoginRequiredLocation "/login"
        AuthFormLoginSuccessLocation  "/"
        SessionMaxAge 604800
        Require all granted
    </Location>
    <Location /logout>
        SetHandler form-logout-handler
        AuthFormLogoutLocation "/login"
        Require all granted
    </Location>

    # Non-interactive endpoints (curl, wget, awstats ...) keep HTTP Basic auth against LDAP
    <LocationMatch "^/(downloads|datasets|stats)(/|$)">
            AuthName "eXo Employees only"
            AuthType Basic
            AuthBasicProvider ldap

            AuthLDAPBindDN          "{{ LDAP_ACCEPTANCE_BIND_DN }}"
            AuthLDAPBindPassword    {{ LDAP_ACCEPTANCE_BIND_PASSWORD }}
            AuthLDAPURL ldaps://ldap2.exoplatform.org/ou=users,ou=portal,dc=exoplatform,dc=org?cn,mail,displayName
            <RequireAll>
                Require    ldap-group cn=exo-employees,ou=groups,dc=exoplatform,dc=org
                AuthLDAPMaxSubGroupDepth 1
            </RequireAll>
    </LocationMatch>
    <Location /rest/>
        Require host exoplatform.org
    </Location>
    <Location /google*.html>
        Require all granted
    </Location>
    <Location /robots.txt>
        Require all granted
    </Location>

    # PWA files — no authentication
    <Location /manifest.json>
        Require all granted
    </Location>
    <Location /sw.js>
        Require all granted
    </Location>
    <Location /images/>
        Require all granted
    </Location>
    # What browsers ask for at the root on their own (a JSON answer, a raw log or a listing has no <link rel=icon>)
    <LocationMatch "^/(favicon\.ico|apple-touch-icon(-precomposed)?\.png)$">
        Require all granted
    </LocationMatch>
    # The sign-in page runs its own two scripts before anyone is signed in; the other scripts stay behind the login
    <LocationMatch "^/js/login(_theme)?\.js$">
        Require all granted
    </LocationMatch>

    AddType application/manifest+json .json

    # ---- adt-web hand-off -------------------------------------------------------------------------------
    # The dashboard is adt-web, listening on the unix socket {{ ADT_WEB_SOCKET }} that only Apache can reach, and it
    # TRUSTS the identity headers below. So: strip whatever the client sent (early), then set them from Apache's own
    # variables (empty for an anonymous visitor).
    RequestHeader unset X-Remote-User    early
    RequestHeader unset X-Remote-Name    early
    RequestHeader unset X-Remote-Mail    early
    RequestHeader unset X-Session-Expiry early
    RequestHeader unset X-Session-User   early
    RequestHeader unset X-Session-Hash   early
    RequestHeader unset X-Request-Line   early

    RequestHeader set X-Remote-User "expr=%{REMOTE_USER}"
    # mod_authnz_ldap exports the attributes requested in AuthLDAPURL (cn,mail,displayName) as AUTHENTICATE_*
    RequestHeader set X-Remote-Name "expr=%{reqenv:AUTHENTICATE_DISPLAYNAME}"
    RequestHeader set X-Remote-Mail "expr=%{reqenv:AUTHENTICATE_MAIL}"
    # On an ErrorDocument (internal redirect) REMOTE_USER and the URL are gone; THE_REQUEST survives.
    RequestHeader set X-Request-Line "expr=%{THE_REQUEST}"

    # Fields of the session, WITHOUT ever forwarding the session payload (it holds the user's password): put the
    # payload in the header, cut the wanted field out with `edit`, then DROP the header unless what is left has
    # exactly the expected shape, so a payload that does not match can never leave Apache. (An <If ... =~> capture
    # does not work here: the <If> is evaluated before SessionEnv fills HTTP_SESSION.)
    #   expiry is in microseconds: X-Session-Expiry is unix seconds (the last six digits are dropped)
    RequestHeader set  X-Session-Expiry "expr=%{reqenv:HTTP_SESSION}"
    RequestHeader edit X-Session-Expiry "^(?:.*&)?expiry=([0-9]+)[0-9]{6}(?:&.*)?$" "$1"
    RequestHeader unset X-Session-Expiry "expr=!(%{req:X-Session-Expiry} =~ /^[0-9]{1,12}$/)"
    #   the "<realm>-user" key: the signed-in login, needed where REMOTE_USER is empty (/login, ErrorDocument 403)
    RequestHeader set  X-Session-User "expr=%{reqenv:HTTP_SESSION}"
    RequestHeader edit X-Session-User "^(?:.*&)?[^&=]*-user=([^&]*)(?:&.*)?$" "$1"
    RequestHeader unset X-Session-User "expr=!(%{req:X-Session-User} =~ /^[A-Za-z0-9._%+@-]{1,128}$/)"

    ProxyPreserveHost On
    RequestHeader set X-Forwarded-Proto "expr=%{REQUEST_SCHEME}"

    # Handled by Apache itself, never proxied. ProxyPass runs before SetHandler, so without the first three the
    # mod_auth_form login/logout handlers would answer 404 from adt-web.
    ProxyPass /dologin          !
    ProxyPass /dologin-remember !
    ProxyPass /logout           !
    # Alias / ScriptAlias above
    ProxyPass /icons/           !
    ProxyPass /downloads/       !
    ProxyPass /datasets/        !
    ProxyPass /logs/            !
    ProxyPass /stats/           !
    ProxyPass /awstatsclasses   !
    ProxyPass /awstats-icon/    !
    ProxyPass /awstatscss       !
    # Static error pages, read from web/static by Apache so they still show when adt-web is down (403 is dynamic)
    AliasMatch "^/errors/frontend/(404|500|502|503)\.html$" "{{ ADT_DATA }}/web/static/errors/$1.html"
    ProxyPassMatch "^/errors/frontend/(404|500|502|503)\.html$" !

    ProxyPass /         "unix:{{ ADT_WEB_SOCKET }}|http://localhost/"
    ProxyPassReverse /  "unix:{{ ADT_WEB_SOCKET }}|http://localhost/"
