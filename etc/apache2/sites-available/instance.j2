{#- Apache virtual host(s) of an instance.
    Switches : DEPLOYMENT_APACHE_SECURITY (public|private), DEPLOYMENT_APACHE_HTTPS_ENABLED, DEPLOYMENT_APACHE_HTTPSONLY_ENABLED
    Each rule protecting a feature is only generated when this feature is enabled (DEPLOYMENT_<FEATURE>_ENABLED): the routing itself is in the nginx of the instance -#}
{% set private = DEPLOYMENT_APACHE_SECURITY == "private" -%}
{% set https = DEPLOYMENT_APACHE_HTTPS_ENABLED == "true" or DEPLOYMENT_APACHE_HTTPSONLY_ENABLED == "true" -%}
{% set httpsonly = DEPLOYMENT_APACHE_HTTPSONLY_ENABLED == "true" -%}
{% macro ldap_auth(indent) -%}
{{ indent }}AuthName "eXo Employees only"
{{ indent }}AuthType Basic
{{ indent }}AuthBasicProvider ldap

{{ indent }}AuthLDAPBindDN          "{{ LDAP_ACCEPTANCE_BIND_DN }}"
{{ indent }}AuthLDAPBindPassword    {{ LDAP_ACCEPTANCE_BIND_PASSWORD }}
{{ indent }}AuthLDAPURL ldaps://ldap2.exoplatform.org/ou=users,ou=portal,dc=exoplatform,dc=org?cn
{{ indent }}<RequireAll>
{{ indent }}    Require    ldap-group cn=exo-employees,ou=groups,dc=exoplatform,dc=org
{{ indent }}    AuthLDAPMaxSubGroupDepth 1
{{ indent }}</RequireAll>
{%- endmacro %}
{% macro protected(path, extra="") %}
    <LocationMatch "{{ path }}">
        Require all denied
{{ ldap_auth("        ") }}
{%- if extra %}
        {{ extra }}
{%- endif %}
    </LocationMatch>
{% endmacro %}
{% macro vhost_body(ssl) %}
    ServerName  {{ DEPLOYMENT_EXT_HOST }}
    ServerAlias {{ DEPLOYMENT_APACHE_VHOST_ALIAS }}
    # nginx forwards what Apache tells about the scheme the client used
    RequestHeader set X-Forwarded-Proto "{{ "https" if ssl else "http" }}"
{% if private %}
    Include {{ APACHE_CONF_DIR }}/includes/{{ DEPLOYMENT_EXT_HOST }}.include

{% if DEPLOYMENT_MATRIX_ENABLED == "true" %}
    # The discovery files of Matrix are public (nginx answers, with the headers)
    <ProxyMatch "^.*/\.well-known/matrix/.*$">
        Require all granted
    </ProxyMatch>

{% endif %}
    # No security for gadgets
    <ProxyMatch "^.*/(eXoGadgetServer|exo-gadget-resources|rest|.*Resources)/.*$">
        Require all granted
    </ProxyMatch>

    # Everything else is secured
    <Proxy *>
{{ ldap_auth("            ") }}
    </Proxy>
{% else %}
{{ protected("^/logs/.*") }}
{%- if DEPLOYMENT_MATRIX_ENABLED == "true" %}
    # The discovery files of Matrix are public (nginx answers, with the headers)
    <LocationMatch "^/.well-known/matrix/.*">
        Require all granted
    </LocationMatch>
{% endif %}
{%- if DEPLOYMENT_ES_ENABLED == "true" %}
{{ protected("^/elasticsearch.*") }}
{%- endif %}
{%- if DEPLOYMENT_MAILPIT_ENABLED == "true" %}
{{ protected("^/mailpit.*") }}
{%- endif %}
{%- if DEPLOYMENT_FRONTAIL_ENABLED == "true" %}
{{ protected("^/livelogs.*") }}
{%- endif %}
{%- if DEPLOYMENT_DEBUG_ENABLED == "true" %}
{{ protected("^/debug-ws.*") }}
{%- endif %}
{%- if DEPLOYMENT_CLOUDBEAVER_ENABLED == "true" %}
{{ protected("^/cloudbeaver.*", 'Header set Cache-Control "max-age=63072000, public"') }}
{%- endif %}
{%- if DEPLOYMENT_LAM_ENABLED == "true" %}
{{ protected("^/lam.*") }}
{%- endif %}

    Include {{ APACHE_CONF_DIR }}/includes/{{ DEPLOYMENT_EXT_HOST }}.include
{% endif %}
{% if ssl %}

    #####################
    # SSL configuration
    #####################
    SSLEngine             on
    SSLCertificateFile       {{ INSTANCE_SSL_CERTIFICATE_FILE }}
    SSLCertificateKeyFile    {{ INSTANCE_SSL_CERTIFICATE_KEY_FILE }}
    Include {{ APACHE_CONF_DIR }}/includes/tls.include
{% endif %}
{% endmacro %}
<VirtualHost *:80>
{% if httpsonly %}
    ServerName  {{ DEPLOYMENT_EXT_HOST }}
    ServerAlias {{ DEPLOYMENT_APACHE_VHOST_ALIAS }}

    RewriteEngine On
    RewriteCond %{HTTPS}  !=on
    RewriteRule ^/?(.*) https://%{SERVER_NAME}/$1 [R,L]
{% else %}
{{ vhost_body(false) }}
{%- endif %}
</VirtualHost>
{% if https %}

<VirtualHost *:443>
{{ vhost_body(true) }}
</VirtualHost>
{% endif %}
