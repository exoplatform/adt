{#- Apache virtual host(s) of an instance.
    Switches : DEPLOYMENT_APACHE_SECURITY (public|private), DEPLOYMENT_APACHE_HTTPS_ENABLED, DEPLOYMENT_APACHE_HTTPSONLY_ENABLED
    Each rule exposing a feature is only generated when this feature is enabled (DEPLOYMENT_<FEATURE>_ENABLED) -#}
{% set private = DEPLOYMENT_APACHE_SECURITY == "private" -%}
{% set https = DEPLOYMENT_APACHE_HTTPS_ENABLED == "true" or DEPLOYMENT_APACHE_HTTPSONLY_ENABLED == "true" -%}
{% set httpsonly = DEPLOYMENT_APACHE_HTTPSONLY_ENABLED == "true" -%}
{% macro ldap_auth(indent) -%}
{{ indent }}AuthName "eXo Employees only"
{{ indent }}AuthType Basic
{{ indent }}AuthBasicProvider ldap

{{ indent }}AuthLDAPBindDN          "{{ LDAP_ACCEPTANCE_BIND_DN }}"
{{ indent }}AuthLDAPBindPassword    {{ LDAP_ACCEPTANCE_BIND_PASSWORD }}
{{ indent }}AuthLDAPURL ldaps://ldap2.exoplatform.org/ou=users,ou=portal,dc=exoplatform,dc=org?cn
{{ indent }}<RequireAll>
{{ indent }}    Require    ldap-group cn=exo-employees,ou=groups,dc=exoplatform,dc=org
{{ indent }}    AuthLDAPMaxSubGroupDepth 1
{{ indent }}</RequireAll>
{%- endmacro %}
{% macro protected(path, extra="") %}
    <LocationMatch "{{ path }}">
        Require all denied
{{ ldap_auth("        ") }}
{%- if extra %}
        {{ extra }}
{%- endif %}
    </LocationMatch>
{% endmacro %}
{% macro vhost_body(ssl) %}
    ServerName  {{ DEPLOYMENT_EXT_HOST }}
    ServerAlias {{ DEPLOYMENT_APACHE_VHOST_ALIAS }}
{% if ssl %}
    RequestHeader set X-Forwarded-Proto "https"
{% endif %}
{% if private %}
    Include {{ APACHE_CONF_DIR }}/includes/{{ DEPLOYMENT_EXT_HOST }}.include

    # No security for gadgets
    <ProxyMatch "^.*/(eXoGadgetServer|exo-gadget-resources|rest|.*Resources)/.*$">
        Require all granted
    </ProxyMatch>
{% if DEPLOYMENT_CHAT_EMBEDDED != "true" %}

    # No security for chat local access
    <ProxyMatch "^.*/chatServer/.*$">
        Require host exoplatform.org
    </ProxyMatch>
{% endif %}

    # Everything else is secured
    <Proxy *>
{{ ldap_auth("            ") }}
    </Proxy>
{% else %}
{{ protected("^/logs/.*") }}
{%- if ssl and DEPLOYMENT_MATRIX_ENABLED == "true" %}
    <LocationMatch "^/.well-known/matrix/.*">
        Options None
        AllowOverride None
        Require all granted
        Header set Content-Type application/json
        Header always set Access-Control-Allow-Origin "https://app.element.io"
        Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Header always set Access-Control-Allow-Headers "Origin, Content-Type, Accept"
        Header always set Access-Control-Max-Age "1728000"
    </LocationMatch>
{% endif %}
{%- if DEPLOYMENT_ES_ENABLED == "true" %}
{{ protected("^/elasticsearch.*") }}
{%- endif %}
{%- if DEPLOYMENT_MAILPIT_ENABLED == "true" %}
{{ protected("^/mailpit.*") }}
{%- endif %}
{%- if DEPLOYMENT_FRONTAIL_ENABLED == "true" %}
{{ protected("^/livelogs.*") }}
{%- endif %}
{%- if DEPLOYMENT_CLOUDBEAVER_ENABLED == "true" %}
{{ protected("^/cloudbeaver.*", 'Header set Cache-Control "max-age=63072000, public"') }}
{%- endif %}
{%- if DEPLOYMENT_MONGO_EXPRESS_ENABLED == "true" %}
{{ protected("^/mongoexpress.*") }}
{%- endif %}
{%- if DEPLOYMENT_CMISSERVER_ENABLED == "true" %}
{{ protected("^/cmis.*") }}
{%- endif %}

    Include {{ APACHE_CONF_DIR }}/includes/{{ DEPLOYMENT_EXT_HOST }}.include
{% endif %}
{% if ssl %}

    #####################
    # SSL configuration
    #####################
    SSLEngine             on
    SSLCertificateFile       {{ INSTANCE_SSL_CERTIFICATE_FILE }}
    SSLCertificateKeyFile    {{ INSTANCE_SSL_CERTIFICATE_KEY_FILE }}
    SSLVerifyClient None

    SSLCipherSuite          ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384
    SSLProtocol             +TLSv1.2 +TLSv1.3
    SSLHonorCipherOrder     on
    SSLCompression          off
    SSLSessionTickets       off
{% endif %}
{% endmacro %}
<VirtualHost *:80>
{% if httpsonly %}
    ServerName  {{ DEPLOYMENT_EXT_HOST }}
    ServerAlias {{ DEPLOYMENT_APACHE_VHOST_ALIAS }}

    RewriteEngine On
    RewriteCond %{HTTPS}  !=on
    RewriteRule ^/?(.*) https://%{SERVER_NAME}/$1 [R,L]
{% else %}
{{ vhost_body(false) }}
{%- endif %}
</VirtualHost>
{% if https %}

<VirtualHost *:443>
{{ vhost_body(true) }}
</VirtualHost>
{% endif %}
