{#- Apache virtual host(s) of an instance.
    Switches : DEPLOYMENT_APACHE_SECURITY (public|private), DEPLOYMENT_APACHE_HTTPS_ENABLED, DEPLOYMENT_APACHE_HTTPSONLY_ENABLED
    Each rule protecting a feature is only generated when this feature is enabled (DEPLOYMENT_<FEATURE>_ENABLED): the routing itself is in the nginx of the instance -#}
{% set private = DEPLOYMENT_APACHE_SECURITY == "private" -%}
{% set https = DEPLOYMENT_APACHE_HTTPS_ENABLED == "true" or DEPLOYMENT_APACHE_HTTPSONLY_ENABLED == "true" -%}
{% set httpsonly = DEPLOYMENT_APACHE_HTTPSONLY_ENABLED == "true" -%}
{% macro ldap_auth(indent) -%}
{{ indent }}AuthName "eXo Employees only"
{{ indent }}AuthType Basic
{{ indent }}AuthBasicProvider ldap

{{ indent }}AuthLDAPBindDN          "{{ LDAP_ACCEPTANCE_BIND_DN }}"
{{ indent }}AuthLDAPBindPassword    {{ LDAP_ACCEPTANCE_BIND_PASSWORD }}
{{ indent }}AuthLDAPURL ldaps://ldap2.exoplatform.org/ou=users,ou=portal,dc=exoplatform,dc=org?cn
{{ indent }}<RequireAll>
{{ indent }}    Require    ldap-group cn=exo-employees,ou=groups,dc=exoplatform,dc=org
{{ indent }}    AuthLDAPMaxSubGroupDepth 1
{{ indent }}</RequireAll>
{%- endmacro %}
{% macro protected(path, extra="") %}
    <LocationMatch "{{ path }}">
        Require all denied
{{ ldap_auth("        ") }}
{%- if extra %}
        {{ extra }}
{%- endif %}
    </LocationMatch>
{% endmacro %}
{% macro vhost_body(ssl) %}
    ServerName  {{ DEPLOYMENT_EXT_HOST }}
    ServerAlias {{ DEPLOYMENT_APACHE_VHOST_ALIAS }}
    # nginx forwards what Apache tells about the scheme the client used
    RequestHeader set X-Forwarded-Proto "{{ "https" if ssl else "http" }}"
{% if private %}
    Include {{ APACHE_CONF_DIR }}/includes/{{ DEPLOYMENT_EXT_HOST }}.include

    # Everything is secured. There used to be <ProxyMatch> exceptions here ("no security for gadgets", "chat local access")
    # in front of this section: they never applied (the later <Proxy *> overrides them, so the rest of the vhost was
    # already behind LDAP) and would have opened the whole vhost had they been moved below it: a ProxyMatch is tested against
    # the URL sent to the backend, so "/rest/..;/portal/" (Tomcat strips ";" and resolves "..") or "/debug-ws/rest/x" (the
    # JDWP tunnel) matched "rest" anywhere and skipped LDAP. Do not add one back (etc/apache2/tests/no-proxymatch.sh).
    <Proxy *>
{{ ldap_auth("            ") }}
    </Proxy>
{% else %}
{{ protected("^/logs/.*") }}
{%- if ssl and DEPLOYMENT_MATRIX_ENABLED == "true" %}
    # Headers of the two discovery documents only. NO "Require" here: a <Location> is merged after the <Directory> and <Files> of
    # the include, so a "Require all granted" would override their rules and serve everything in the directory
    # (homeserver.yaml, initialize.sh, the signing key). Who may read what is decided in includes/instance.include.j2.
    <LocationMatch "^/.well-known/matrix/(client|server)$">
        Header set Content-Type application/json
        Header always set Access-Control-Allow-Origin "https://app.element.io"
        Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Header always set Access-Control-Allow-Headers "Origin, Content-Type, Accept"
        Header always set Access-Control-Max-Age "1728000"
    </LocationMatch>
{% endif %}
{%- if DEPLOYMENT_ES_ENABLED == "true" %}
{{ protected("^/elasticsearch.*") }}
{%- endif %}
{%- if DEPLOYMENT_MAILPIT_ENABLED == "true" %}
{{ protected("^/mailpit.*") }}
{%- endif %}
{%- if DEPLOYMENT_FRONTAIL_ENABLED == "true" %}
{{ protected("^/livelogs.*") }}
{%- endif %}
{%- if DEPLOYMENT_DEBUG_ENABLED == "true" and DEPLOYMENT_DEBUG_EXPOSE_PORT != "true" %}
{{ protected("^/debug-ws.*") }}
{%- endif %}
{%- if DEPLOYMENT_CLOUDBEAVER_ENABLED == "true" %}
{{ protected("^/cloudbeaver.*", 'Header set Cache-Control "max-age=63072000, public"') }}
{%- endif %}
{%- if DEPLOYMENT_LAM_ENABLED == "true" %}
{{ protected("^/lam.*") }}
{%- endif %}

    Include {{ APACHE_CONF_DIR }}/includes/{{ DEPLOYMENT_EXT_HOST }}.include
{% endif %}
{% if ssl %}

    #####################
    # SSL configuration
    #####################
    SSLEngine             on
    SSLCertificateFile       {{ INSTANCE_SSL_CERTIFICATE_FILE }}
    SSLCertificateKeyFile    {{ INSTANCE_SSL_CERTIFICATE_KEY_FILE }}
    Include {{ APACHE_CONF_DIR }}/includes/tls.include
{% endif %}
{% endmacro %}
<VirtualHost *:80>
{% if httpsonly %}
    ServerName  {{ DEPLOYMENT_EXT_HOST }}
    ServerAlias {{ DEPLOYMENT_APACHE_VHOST_ALIAS }}

    RewriteEngine On
    RewriteCond %{HTTPS}  !=on
    RewriteRule ^/?(.*) https://%{SERVER_NAME}/$1 [R,L]
{% else %}
{{ vhost_body(false) }}
{%- endif %}
</VirtualHost>
{% if https %}

<VirtualHost *:443>
{{ vhost_body(true) }}
</VirtualHost>
{% endif %}
