{% if DEPLOYMENT_MAILPIT_ENABLED == "true" %}
    # Mailpit: the mails the application sent (the authentication of this URI is done by Apache)
    location = /mailpit {
      return 301 /mailpit/;
    }
    location /mailpit/ {
      set $upstream_mailpit http://mailpit:8025;
      proxy_pass $upstream_mailpit;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
    }

{% endif %}
