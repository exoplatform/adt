{% if DEPLOYMENT_MATRIX_ENABLED == "true" %}
    # Matrix (Synapse): discovery files, then the client and the federation APIs
    location /.well-known/matrix/ {
      alias /srv/matrix/;
      default_type application/json;
      add_header Access-Control-Allow-Origin "https://app.element.io" always;
      add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
      add_header Access-Control-Allow-Headers "Origin, Content-Type, Accept" always;
      add_header Access-Control-Max-Age "1728000" always;
    }
    # the push gateway notifications are handled by the application itself
    location = /_matrix/push/v1/notify {
      set $upstream_app http://exo:8080;
      rewrite ^ /matrix/rest/matrix/notify break;
      proxy_pass $upstream_app;
      add_header Access-Control-Allow-Headers "Authorization" always;
    }
    location ~ ^/(_matrix|_synapse)(/|$) {
      set $upstream_matrix http://matrix:8008;
      proxy_pass $upstream_matrix;
    }

{% endif %}
