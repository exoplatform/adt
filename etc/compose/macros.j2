{#- Shared by the compose project (docker-compose.yml.j2) and its included files.
    y(v): a string quoted for YAML, with "$" escaped for docker compose. -#}
{% macro y(v) %}{{ v | replace('$', '$$') | tojson }}{% endmacro %}
{#- prop(v): a value of a .properties file (the backslash is the only character that needs an escape in a value) -#}
{% macro prop(v) %}{{ v | replace("\\", "\\\\") | replace("\n", "\\n") }}{% endmacro %}
