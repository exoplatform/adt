{#- The docker compose project of an instance, rendered by adt.sh (deploy) in ${SRV_DIR}/<instance key>/docker-compose.yml.
    Every string goes through y() (macros.j2): it is quoted for YAML and "$" is escaped for docker compose.
    Core services: web (nginx), exo (the product), db, search. Every companion service is one file of services/ (its compose
    service), one of integrations/ (what the application must know to use it) and one of locations/ (its nginx locations):
    each is only active when DEPLOYMENT_<SERVICE>_ENABLED is true.
    An integration file adds to the collectors below, which feed the application service:
      app_opts     JVM options (JAVA_OPTS)       app_env      environment variables
      app_props    properties of exo.properties (exo.properties.j2 renders them, adt.sh puts the file in the application container)
      app_volumes  volumes of the application    app_depends  services that must be healthy before it starts
    A service file adds the named volumes it uses to top_volumes. -#}
{% from "macros.j2" import y -%}
{% set P = DEPLOYMENT_ENV_PREFIX -%}
{% set app = DEPLOYMENT_ENV_PREFIX | lower -%}
{% set tls = DEPLOYMENT_NGINX_TLS == "true" -%}
{% set db = DEPLOYMENT_DB_TYPE != "HSQLDB" -%}
{% set db_user = DEPLOYMENT_DATABASE_USER -%}
{% set db_root_password = DEPLOYMENT_DATABASE_NAME ~ "@root" -%}
{% set app_opts = [] -%}
{% set app_env = {} -%}
{% set app_volumes = [] -%}
{% set app_depends = [] -%}
{% set top_volumes = [] -%}
{% set app_props = {} -%}
{% set _integrations %}{% include "integrations/all.j2" %}{% endset -%}
# Rendered by ADT from etc/compose/docker-compose.yml.j2: do not edit, the next deploy overwrites it.
name: {{ DEPLOYMENT_COMPOSE_PROJECT }}

x-logging: &logging
  driver: json-file
  options:
    max-size: "50m"
    max-file: "3"

services:
  # Reverse proxy of the instance: the only published port, reached by the Apache virtual host
  web:
    image: {{ y(DEPLOYMENT_NGINX_IMAGE ~ ":" ~ DEPLOYMENT_NGINX_IMAGE_VERSION) }}
    container_name: {{ y(INSTANCE_KEY ~ "_web") }}
    labels:
      adt.instance: {{ y(INSTANCE_KEY) }}
      adt.host: {{ y(ACCEPTANCE_HOST) }}
      adt.role: "proxy"
      adt.nginx: "true"
    ports:
      - "127.0.0.1:{{ DEPLOYMENT_HTTP_PORT }}:{{ "443" if tls else "80" }}"
{% if DEPLOYMENT_EXT_HOST != "localhost" %}
    # The containers of the instance (the document server calling the application back, the application calling Keycloak or Matrix...)
    # reach the public names of the instance through nginx, without going out and back in through the server
    networks:
      default:
        aliases:
          - {{ y(DEPLOYMENT_EXT_HOST) }}
{% if DEPLOYMENT_APACHE_VHOST_ALIAS %}
          - {{ y(DEPLOYMENT_APACHE_VHOST_ALIAS) }}
{% endif %}
{% endif %}
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - ./logs/nginx:/var/log/nginx
      - ./logs/app:/var/log/app:ro
      - {{ y(ADT_DATA ~ "/web/static:/srv/static:ro") }}
{% if DEPLOYMENT_MATRIX_ENABLED == "true" %}
      # the discovery files only (the directory of the Matrix server holds its secrets)
      - ./matrix-wellknown:/srv/matrix:ro
{% endif %}
{% if tls and DEPLOYMENT_CERTBOT_ENABLED == "true" %}
      # certbot renews the certificate in this tree: mount the directory, a file bind mount would keep the old inode
      - {{ y(DEPLOYMENT_CERTBOT_CONFIG_FOLDER ~ ":/etc/letsencrypt:ro") }}
{% elif tls %}
      - {{ y(INSTANCE_SSL_CERTIFICATE_FILE ~ ":/etc/nginx/certs/fullchain.pem:ro") }}
      - {{ y(INSTANCE_SSL_CERTIFICATE_KEY_FILE ~ ":/etc/nginx/certs/privkey.pem:ro") }}
{% endif %}
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:8081/nginx-health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 5s
    logging: *logging

  exo:
    image: {{ y(DEPLOYMENT_IMAGE) }}
    container_name: {{ y(INSTANCE_KEY ~ "_exo") }}
    labels:
      adt.instance: {{ y(INSTANCE_KEY) }}
      adt.host: {{ y(ACCEPTANCE_HOST) }}
      adt.role: "app"
      # exo.properties is copied in the container by adt.sh: its checksum makes compose recreate the container when it changes
      adt.properties: {{ y(DEPLOYMENT_PROPERTIES_SHA) }}
    environment:
      {{ P }}_PROXY_VHOST: {{ y(DEPLOYMENT_PROXY_VHOST) }}
      {{ P }}_PROXY_PORT: {{ y(DEPLOYMENT_PROXY_PORT) }}
      {{ P }}_PROXY_SSL: {{ y(DEPLOYMENT_PROXY_SSL) }}
      {{ P }}_JVM_SIZE_MIN: {{ y(DEPLOYMENT_JVM_SIZE_MIN) }}
      {{ P }}_JVM_SIZE_MAX: {{ y(DEPLOYMENT_JVM_SIZE_MAX) }}
      {{ P }}_JVM_LOG_GC_ENABLED: "true"
      {{ P }}_UPLOAD_MAX_FILE_SIZE: {{ y(DEPLOYMENT_UPLOAD_MAX_FILE_SIZE) }}
      {{ P }}_GZIP_ENABLED: {{ y(DEPLOYMENT_GZIP_ENABLED) }}
      {{ P }}_JMX_ENABLED: "false"
      {{ P }}_ADDONS_LIST: {{ y(DEPLOYMENT_ADDONS) }}
{% if DEPLOYMENT_ADDONS_TOREMOVE %}
      {{ P }}_ADDONS_REMOVE_LIST: {{ y(DEPLOYMENT_ADDONS_TOREMOVE) }}
{% endif %}
{% if DEPLOYMENT_ADDONS_CATALOG %}
      {{ P }}_ADDONS_CATALOG_URL: {{ y(DEPLOYMENT_ADDONS_CATALOG) }}
{% endif %}
{% if DEPLOYMENT_ADDONS_MANAGER_CONFLICT_MODE %}
      {{ P }}_ADDONS_CONFLICT_MODE: {{ y(DEPLOYMENT_ADDONS_MANAGER_CONFLICT_MODE) }}
{% endif %}
{% if DEPLOYMENT_ADDONS_MANAGER_NOCOMPAT_MODE %}
      {{ P }}_ADDONS_NOCOMPAT_MODE: {{ y(DEPLOYMENT_ADDONS_MANAGER_NOCOMPAT_MODE) }}
{% endif %}
{% if DEPLOYMENT_PATCHES %}
      {{ P }}_PATCHES_LIST: {{ y(DEPLOYMENT_PATCHES) }}
      {{ P }}_PATCHES_CATALOG_URL: {{ y(DEPLOYMENT_PATCHES_CATALOG) }}
{% endif %}
{% if DEPLOYMENT_SELFSIGNEDCERTS_HOSTS %}
      {{ P }}_SELFSIGNEDCERTS_HOSTS: {{ y(DEPLOYMENT_SELFSIGNEDCERTS_HOSTS) }}
{% endif %}
{% set java_opts = ([DEPLOYMENT_OPTS] if DEPLOYMENT_OPTS else []) + app_opts %}
{% if java_opts %}
      JAVA_OPTS: {{ y(java_opts | join(" ")) }}
{% endif %}
{% for name, value in app_env.items() %}
      {{ name }}: {{ y(value) }}
{% endfor %}
      {{ P }}_DB_TYPE: {{ y(DEPLOYMENT_DB_ENV_TYPE) }}
{% if db %}
      {{ P }}_DB_HOST: "db"
      {{ P }}_DB_PORT: {{ y(DEPLOYMENT_DATABASE_PORT) }}
      {{ P }}_DB_NAME: {{ y(DEPLOYMENT_DATABASE_NAME) }}
      {{ P }}_DB_USER: {{ y(db_user) }}
      {{ P }}_DB_PASSWORD: {{ y(db_user) }}
{% endif %}
      {{ P }}_ES_SCHEME: "http"
      {{ P }}_ES_HOST: "search"
      {{ P }}_ES_PORT: "9200"
      {{ P }}_ES_INDEX_REPLICA_NB: "0"
    volumes:
      - exo_data:/srv/{{ app }}
      - exo_codec:/etc/{{ app }}/codec
      - ./logs/app:/var/log/{{ app }}
{% for volume in app_volumes %}
      - {{ y(volume) }}
{% endfor %}
{% if DEPLOYMENT_LICENSE_MOUNT %}
      - {{ y(DEPLOYMENT_LICENSE_MOUNT ~ ":/etc/exo/license.xml:ro") }}
{% endif %}
    depends_on:
      search:
        condition: service_healthy
{% if db %}
      db:
        condition: service_healthy
{% endif %}
{% for service in app_depends %}
      {{ service }}:
        condition: service_healthy
{% endfor %}
    # the image has its own HEALTHCHECK (curl on 8080): only the timings are tuned, the startup of an instance takes minutes
    healthcheck:
      test: ["CMD-SHELL", "curl --fail --silent --output /dev/null http://localhost:8080/ || exit 1"]
      interval: 15s
      timeout: 10s
      retries: 20
      start_period: 120s
    logging: *logging

{% if db and DEPLOYMENT_DB_TYPE == "MYSQL" %}
  db:
    image: {{ y("mysql:" ~ DEPLOYMENT_DATABASE_VERSION) }}
    container_name: {{ y(INSTANCE_KEY ~ "_db") }}
    labels:
      adt.instance: {{ y(INSTANCE_KEY) }}
      adt.role: "db"
    environment:
      MYSQL_ROOT_PASSWORD: {{ y(db_root_password) }}
      MYSQL_DATABASE: {{ y(DEPLOYMENT_DATABASE_NAME) }}
      MYSQL_USER: {{ y(db_user) }}
      MYSQL_PASSWORD: {{ y(db_user) }}
    volumes:
      - db:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", {{ y("mysqladmin -h localhost -u " ~ db_user ~ " -p" ~ db_user ~ " ping --silent") }}]
      interval: 10s
      timeout: 10s
      retries: 30
      start_period: 30s
    logging: *logging

{% elif db and DEPLOYMENT_DB_TYPE == "MARIADB" %}
  db:
    image: {{ y("mariadb:" ~ DEPLOYMENT_DATABASE_VERSION) }}
    container_name: {{ y(INSTANCE_KEY ~ "_db") }}
    labels:
      adt.instance: {{ y(INSTANCE_KEY) }}
      adt.role: "db"
    environment:
      MARIADB_ROOT_PASSWORD: {{ y(db_root_password) }}
      MARIADB_DATABASE: {{ y(DEPLOYMENT_DATABASE_NAME) }}
      MARIADB_USER: {{ y(db_user) }}
      MARIADB_PASSWORD: {{ y(db_user) }}
    volumes:
      - db:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "healthcheck.sh --connect --innodb_initialized"]
      interval: 10s
      timeout: 10s
      retries: 30
      start_period: 30s
    logging: *logging

{% elif db and DEPLOYMENT_DB_TYPE == "POSTGRES" %}
  db:
    image: {{ y("postgres:" ~ DEPLOYMENT_DATABASE_VERSION) }}
    container_name: {{ y(INSTANCE_KEY ~ "_db") }}
    labels:
      adt.instance: {{ y(INSTANCE_KEY) }}
      adt.role: "db"
    environment:
      POSTGRES_DB: {{ y(DEPLOYMENT_DATABASE_NAME) }}
      POSTGRES_USER: {{ y(db_user) }}
      POSTGRES_PASSWORD: {{ y(db_user) }}
    volumes:
      # PostgreSQL 18 images keep the version directories under /var/lib/postgresql
      - db:{{ "/var/lib/postgresql" if (DEPLOYMENT_DATABASE_VERSION.split(".")[0] | int) >= 18 else "/var/lib/postgresql/data" }}
    healthcheck:
      test: ["CMD-SHELL", {{ y("pg_isready -U " ~ db_user ~ " -d " ~ DEPLOYMENT_DATABASE_NAME) }}]
      interval: 10s
      timeout: 10s
      retries: 30
      start_period: 20s
    logging: *logging

{% endif %}
  search:
    image: {{ y(DEPLOYMENT_ES_IMAGE ~ ":" ~ DEPLOYMENT_ES_IMAGE_VERSION) }}
    container_name: {{ y(INSTANCE_KEY ~ "_search") }}
    hostname: "search"
    labels:
      adt.instance: {{ y(INSTANCE_KEY) }}
      adt.role: "search"
    environment:
      ES_JAVA_OPTS: {{ y("-Xms" ~ DEPLOYMENT_ES_HEAP ~ " -Xmx" ~ DEPLOYMENT_ES_HEAP) }}
      node.name: {{ y(INSTANCE_KEY) }}
      cluster.name: {{ y(INSTANCE_KEY) }}
      cluster.initial_master_nodes: {{ y(INSTANCE_KEY) }}
      xpack.security.enabled: "false"
    volumes:
      - search:/usr/share/elasticsearch/data
    healthcheck:
      test: ["CMD-SHELL", "curl --silent --fail http://localhost:9200/_cluster/health || exit 1"]
      interval: 10s
      timeout: 10s
      retries: 30
      start_period: 30s
    logging: *logging

{% include "services/mailpit.yml.j2" %}
{% include "services/iframely.yml.j2" %}
{% include "services/ai.yml.j2" %}
{% include "services/sftp.yml.j2" %}
{% include "services/ldap.yml.j2" %}
{% include "services/lam.yml.j2" %}
{% include "services/cloudbeaver.yml.j2" %}
{% include "services/clamav.yml.j2" %}
{% include "services/caldav.yml.j2" %}
{% include "services/frontail.yml.j2" %}
{% include "services/onlyoffice.yml.j2" %}
{% include "services/matrix.yml.j2" %}
{% include "services/keycloak.yml.j2" %}
{% include "services/jitsi.yml.j2" %}
{% include "services/debug.yml.j2" %}

# Everything docker creates is named after the instance key, so that many instances of the same products stay readable on a host
volumes:
  exo_data:
    name: {{ y(INSTANCE_KEY ~ "_exo_data") }}
  exo_codec:
    name: {{ y(INSTANCE_KEY ~ "_exo_codec") }}
{% if db %}
  db:
    name: {{ y(INSTANCE_KEY ~ "_db") }}
{% endif %}
  search:
    name: {{ y(INSTANCE_KEY ~ "_search") }}
{% for volume in top_volumes %}
  {{ volume }}:
    name: {{ y(INSTANCE_KEY ~ "_" ~ volume) }}
{% endfor %}

networks:
  default:
    name: {{ y(INSTANCE_KEY) }}
