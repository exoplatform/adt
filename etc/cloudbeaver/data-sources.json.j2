				"password": "{{ DEPLOYMENT_DATABASE_USER }}",
				"configurationType": "MANUAL",
				"type": "dev",
				"properties": {
{%- if DEPLOYMENT_DB_TYPE == "DOCKER_POSTGRES" %}
					"readOnly": "{{ DEPLOYMENT_CLOUDBEAVER_READONLY }}"
{%- else %}
					"allowPublicKeyRetrieval": "true"
{%- endif %}
				},
				"auth-model": "native",
				"handlers": {}
			}
		}
	},
	"connection-types": {
