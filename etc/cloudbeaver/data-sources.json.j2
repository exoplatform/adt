			"show-system-objects": true,
			"read-only": {{ DEPLOYMENT_CLOUDBEAVER_READONLY }},
			"configuration": {
				"host": "host.docker.internal",
				"port": "{{ conn.port }}",
				"database": "{{ DEPLOYMENT_DATABASE_NAME }}",
				"url": "jdbc:{{ conn.jdbc }}://host.docker.internal:{{ conn.port }}/{{ DEPLOYMENT_DATABASE_NAME }}",
